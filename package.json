{
  "private": true,
  "scripts": {
    "build": "wp-scripts build",
    "dev": "wp-scripts start",
    "dev:hot": "wp-scripts start --hot",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@wordpress/icons": "^15.4.0",
    "@wordpress/scripts": "^34.1.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@wordpress/blocks": "^15.26.0",
    "@wordpress/dom-ready": "^4.53.0",
    "@wordpress/i18n": "^6.26.0",
    "oxfmt": "^0.64.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.15.1 <12.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0",
      "onFail": "warn"
    }
  }
}
